    "name": "Nursery Check-in API - Local",
    "description": "Tests for the Laravel nursery check-in API. Start Laravel Sail first. This collection assumes API routes are under /api and the database has seeded tenants, rooms, and children. Set IDs in collection variables before running. Tests assert status codes and response shape; tenant isolation tests assume tenant 1 owns room/child/check-in IDs for tenant A and tenant 2 owns IDs for tenant B. Some negative tests may reveal implementation gaps rather than pass with the current code.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "58307082",
    "_collection_link": "https://go.postman.co/collection/58307082-19ef4649-54a2-475d-b1a4-053d9f28ee61?source=collection_link"
  },
  "item": [
    {
      "name": "01 - Check-in",
      "item": [
        {
          "name": "Check in child A to room A",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status is 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"Response contains check-in data\", () => {",
                  "  const json = pm.response.json();",
                  "  pm.expect(json).to.have.property(\"data\");",
                  "  pm.expect(json.data).to.have.property(\"id\");",
                  "  pm.expect(json.data).to.have.property(\"checked_in_at\");",
                  "  pm.expect(json.data.checked_out_at).to.be.oneOf([null, undefined]);",
                  "});",
                  "const json = pm.response.json();",
                  "if (json.data && json.data.id) pm.collectionVariables.set(\"createdCheckInId\", String(json.data.id));"
                ],
                "type": "text/javascript",
                "packages": {},
                "requests": {}
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "X-Tenant-ID",
                "value": "{{tenantA}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"child_id\": \"{{childA}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/rooms/{{roomA}}/check-ins",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "rooms",
                "{{roomA}}",
                "check-ins"
              ]
            },
            "description": "Happy path. Run once per fresh child; repeating should be rejected while the child remains checked in."
          },
          "response": []
        },
